# Example systemd user unit for the Bitwarden CLI's local API.
# Install:  cp contrib/bw-serve.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now bw-serve
# Adjust ExecStart if `bw` is not at ~/.local/bin/bw (check with: command -v bw).
[Unit]
Description=Bitwarden CLI local Vault Management API (loopback only)
Documentation=https://bitwarden.com/help/cli/#serve
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/bw serve --hostname 127.0.0.1 --port 8087
Restart=on-failure
RestartSec=2
# Vault data lives under ~/.config/Bitwarden CLI/ ; serve starts LOCKED.

[Install]
WantedBy=default.target
